# Server Configuration
PORT=5000

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apliiq Integration
# Get these from your Apliiq account dashboard
APLIIQ_APP_KEY=your_apliiq_app_key_here
APLIIQ_SHARED_SECRET=your_apliiq_shared_secret_here
APLIIQ_BASE_URL=https://apliiq.com/api

# Resend Email Configuration
# Get API key from https://resend.com/api-keys
# IMPORTANT: Verify your domain at https://resend.com/domains before sending emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@9thform.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://9thform.com
